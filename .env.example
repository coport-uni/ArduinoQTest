# Example environment for the helper scripts in claude_test/.
#
# Copy to `.env`, fill in the real values, and keep it out of git --
# `.env` is already in .gitignore, this example file is not. Nothing
# reads `.env` automatically; source it in the shell you are working
# from (see USAGE at the bottom).

# ---------------------------------------------------------------
# TP-Link / Tapo account (claude_test/ha_add_tapo.sh)
# ---------------------------------------------------------------
# The account the plugs are paired to in the Tapo app. Home Assistant
# needs it once per device: the tplink integration keeps the account
# in memory only (`set_credentials` writes to `hass.data`), and the
# `credentials_hash` it does persist is per-device, so a newly added
# plug always asks again after an HA restart.
#
# KLAP authentication is case-sensitive for BOTH the email and the
# password. Copy them exactly as typed in the Tapo app.
TAPO_USER=you@example.com
TAPO_PASS=your-tapo-password

# ---------------------------------------------------------------
# Home Assistant API (claude_test/ha_flows.py, mint_ll.py, ...)
# ---------------------------------------------------------------
# Long-lived access token. On the board it already lives in
# ~/.ha_token, so most scripts are run there as
# `HA_TOKEN=$(cat ~/.ha_token) ...` and this is only needed when
# calling the API from somewhere else.
HA_TOKEN=

# Base URL of the Home Assistant instance. Scripts default to
# localhost because they run on the board; set this to the LAN
# address when driving HA from this checkout instead.
HA_BASE=http://localhost:8123

# Owner account used by claude_test/ha_onboard.sh on a fresh install.
# Only needed for first-boot onboarding, not for day-to-day work.
HA_USER=arduino
HA_PASS=arduino

# Where ha_onboard.sh writes the token it mints.
HA_TOKEN_FILE=$HOME/.ha_token

# Short-lived onboarding token consumed by claude_test/mint_ll.py to
# mint the long-lived one. Empty except during onboarding.
HA_SHORT_TOKEN=

# ---------------------------------------------------------------
# MQTT broker (apps/ha-mcu-bridge/python/main.py)
# ---------------------------------------------------------------
# The bridge container reaches mosquitto over the docker0 gateway.
# Override only if the broker moves.
MQTT_HOST=172.17.0.1

# ---------------------------------------------------------------
# USAGE
# ---------------------------------------------------------------
# Register a Tapo plug, passing the account through to the board
# without ever writing it to disk there:
#
#   set -a; . ./.env; set +a
#   scp claude_test/ha_add_tapo.sh unoq:/home/arduino/
#   ssh unoq "sed -i 's/\r$//' ha_add_tapo.sh && \
#     TAPO_USER='$TAPO_USER' TAPO_PASS='$TAPO_PASS' \
#     bash ha_add_tapo.sh c0:3a:55:3f:17:c0"
#
# The `sed` is not optional: scripts copied from this Windows
# checkout carry CRLF and bash rejects them.
